# Copy to .env (git-ignored) and fill in values on the machine that runs Phase 0b.
# Names only; never commit values.

# ElevenLabs API key (Starter plan, bought by Ahmed). Read by phase0/*.py and by
# the CLI in agent/ (it finds this file from agent/ by walking up).
ELEVENLABS_API_KEY=

# Phase 1 tools backend. TOOL_SECRET: random, local only; generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In Phase 2 the same value is stored on ElevenLabs as a Secret (never in tool_configs/).
TOOL_SECRET=
# Written by scripts/tunnel.sh (the quick-tunnel hostname changes every run).
TOOLS_BASE_URL=
